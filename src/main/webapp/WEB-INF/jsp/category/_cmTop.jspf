<%-- Module 2 page header. The including page sets: cmTitle, cmTab, cmPublic (ASCII only in this fragment). --%>
<%@ page import="com.pation.awardnomination.category.CategoryHtml" %>
<%
    String cx = request.getContextPath();
    String cmActor = (String) request.getAttribute("actor");
    String cmOk = (String) request.getAttribute("cmOk");
    String cmErr = (String) request.getAttribute("cmError");
    Object cmIsManagerObj = request.getAttribute("isManager");
    boolean cmIsManager = !cmPublic || Boolean.TRUE.equals(cmIsManagerObj);
    java.time.LocalTime cmNow = java.time.LocalTime.now();
    String cmClock = String.format(java.util.Locale.ROOT, "%02d%02d%02d", cmNow.getHour(), cmNow.getMinute(), cmNow.getSecond());
%>
<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title><%= CategoryHtml.h(cmTitle) %> &middot; Award Category Management</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=JetBrains+Mono:wght@400;500;700&family=Space+Grotesk:wght@400;500;600;700&display=swap">
<link rel="stylesheet" href="<%= cx %>/css/category-module.css">
<script src="<%= cx %>/js/category-module.js" defer></script>
</head>
<body class="cm-body">
<header class="cm-top">
  <div class="cm-top-in">
    <a class="cm-brand" href="<%= cx %><%= cmIsManager ? "/manager/awards" : "/timeline" %>">
      <span class="cm-brand-mark" aria-hidden="true">
        <svg viewBox="0 0 24 24" fill="none" stroke="#fff" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="13" r="8"/><path d="M12 9v4l2.5 2.5"/><path d="M9 2h6"/><path d="M12 2v3"/></svg>
      </span>
      <span class="cm-brand-text">
        <strong>Award Category Management</strong>
        <span>Module 2 &middot; Time engine</span>
      </span>
    </a>
    <div class="cm-top-right">
      <div class="cm-clock" data-cm-clock aria-label="Current time">
        <span class="cm-flap"><%= cmClock.charAt(0) %></span><span class="cm-flap"><%= cmClock.charAt(1) %></span><span class="cm-clock-sep">:</span><span class="cm-flap"><%= cmClock.charAt(2) %></span><span class="cm-flap"><%= cmClock.charAt(3) %></span><span class="cm-clock-sep">:</span><span class="cm-flap"><%= cmClock.charAt(4) %></span><span class="cm-flap"><%= cmClock.charAt(5) %></span>
      </div>
      <% if (cmActor != null) { %>
      <span class="cm-who"><i><%= CategoryHtml.h(cmActor.substring(0, 1).toUpperCase()) %></i><%= CategoryHtml.h(cmActor) %></span>
      <% } %>
      <a class="cm-top-link" href="<%= cx %>/dashboard">Main dashboard</a>
      <a class="cm-top-link" href="<%= cx %>/logout">Sign out</a>
    </div>
  </div>
</header>
<nav class="cm-nav" aria-label="Module 2">
  <div class="cm-nav-in">
    <% if (cmIsManager) { %>
    <a href="<%= cx %>/manager/awards" class="<%= "board".equals(cmTab) || "detail".equals(cmTab) ? "on" : "" %>"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="4" width="18" height="16" rx="2"/><path d="M3 10h18M9 4v16"/></svg>Control board</a>
    <a href="<%= cx %>/manager/awards/new" class="<%= "new".equals(cmTab) ? "on" : "" %>"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 5v14M5 12h14"/></svg>New category</a>
    <a href="<%= cx %>/manager/awards/stats" class="<%= "stats".equals(cmTab) ? "on" : "" %>"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M4 20V10M10 20V4M16 20v-7M22 20H2"/></svg>Live statistics</a>
    <a href="<%= cx %>/manager/awards/archive" class="<%= "archive".equals(cmTab) ? "on" : "" %>"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="4" width="18" height="5" rx="1"/><path d="M5 9v10h14V9M10 13h4"/></svg>Archive</a>
    <% } %>
    <a href="<%= cx %>/timeline" class="<%= "calendar".equals(cmTab) ? "on" : "" %>"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="5" width="18" height="16" rx="2"/><path d="M3 10h18M8 3v4M16 3v4"/></svg>Award calendar</a>
  </div>
</nav>
<main class="cm-main">
<% if (cmOk != null) { %>
<div class="cm-flash cm-flash-ok" role="status"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4"><path d="M5 12l5 5L20 7"/></svg><span><%= CategoryHtml.h(cmOk) %></span></div>
<% } %>
<% if (cmErr != null) { %>
<div class="cm-flash cm-flash-err" role="alert"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4"><path d="M12 8v5M12 17h.01"/><circle cx="12" cy="12" r="9"/></svg><span><%= CategoryHtml.h(cmErr) %></span></div>
<% } %>
