<%--
  AI Assistant - one file, included in the nominee pages with:  include file="nomineeChatbot.jspf"
  - Stays fixed at the bottom right ("Talk to AI" button). It does not move around the page.
  - The pulse ring and the short greeting bubble make it easy for a nominee to notice.
  - Answers come from getBotResponse(): keyword rules in JavaScript (no external AI service).
  Keep this file ASCII-only (use HTML entities): an included fragment has no page encoding of its own.
--%>
<style>
    /* ===== 1. "Talk to AI" button (bottom right) ===== */
    .ai-launcher {
        position: fixed; right: 24px; bottom: 24px; z-index: 9999;
        display: flex; align-items: center; gap: 10px;
        padding: 7px 18px 7px 7px; border: 0; border-radius: 999px;
        background: #ffffff; color: #1e1b4b;
        font: 700 0.95rem 'Manrope', 'Segoe UI', sans-serif; cursor: pointer;
        box-shadow: 0 10px 30px rgba(49, 46, 129, 0.30);
    }
    .ai-launcher:hover { box-shadow: 0 12px 34px rgba(49, 46, 129, 0.45); }
    .ai-launcher:focus-visible { outline: 3px solid #a78bfa; outline-offset: 3px; }

    /* round avatar with the sparkle icon */
    .ai-avatar {
        position: relative; flex: none; width: 40px; height: 40px; border-radius: 50%;
        display: flex; align-items: center; justify-content: center;
        background: linear-gradient(135deg, #7c3aed, #4f46e5);
    }
    .ai-avatar svg { width: 22px; height: 22px; }
    .ai-dot { position: absolute; right: -1px; bottom: -1px; width: 12px; height: 12px; border-radius: 50%; background: #22c55e; border: 2px solid #ffffff; }

    /* highlight: a ring that pulses out from the avatar (stops when the chat is open) */
    .ai-launcher .ai-avatar::after {
        content: ''; position: absolute; inset: -5px; border-radius: 50%;
        border: 2px solid #8b5cf6; animation: aiPulse 2.4s ease-out infinite;
    }
    .ai-launcher.is-open .ai-avatar::after { animation: none; opacity: 0; }
    @keyframes aiPulse { 0% { transform: scale(0.9); opacity: 0.9; } 100% { transform: scale(1.5); opacity: 0; } }

    /* greeting bubble: appears once, then fades away */
    .ai-teaser {
        position: fixed; right: 24px; bottom: 88px; z-index: 9999; max-width: 250px;
        padding: 10px 14px; border-radius: 14px 14px 4px 14px;
        background: #1e1b4b; color: #ffffff; font: 600 0.88rem/1.45 'Manrope', 'Segoe UI', sans-serif;
        box-shadow: 0 10px 24px rgba(30, 27, 75, 0.35); pointer-events: none;
        animation: aiTeaser 9s ease 1s both;
    }
    @keyframes aiTeaser { 0% { opacity: 0; transform: translateY(8px); } 8%, 85% { opacity: 1; transform: none; } 100% { opacity: 0; transform: translateY(8px); } }

    /* ===== 2. Chat window ===== */
    .ai-window {
        position: fixed; right: 24px; bottom: 92px; z-index: 9999;
        width: 370px; max-width: calc(100vw - 32px); height: 520px; max-height: calc(100vh - 140px);
        display: none; flex-direction: column; overflow: hidden;
        background: #ffffff; border-radius: 20px; box-shadow: 0 24px 60px rgba(30, 27, 75, 0.35);
        font-family: 'Manrope', 'Segoe UI', sans-serif;
    }
    .ai-window.is-open { display: flex; }
    .ai-head { display: flex; align-items: center; gap: 12px; padding: 14px 16px; background: linear-gradient(135deg, #4c1d95, #312e81); color: #ffffff; }
    .ai-head h3 { margin: 0; font-size: 1rem; }
    .ai-head p { margin: 2px 0 0; font-size: 0.8rem; color: #c7d2fe; }
    .ai-close { margin-left: auto; padding: 4px 8px; border: 0; background: none; color: #ffffff; font-size: 1.5rem; line-height: 1; cursor: pointer; }

    .ai-body { flex: 1; overflow-y: auto; padding: 16px; display: flex; flex-direction: column; gap: 10px; background: #f6f5fb; }
    .ai-msg { max-width: 85%; padding: 10px 13px; border-radius: 14px; font-size: 0.9rem; line-height: 1.45; }
    .ai-msg.bot { align-self: flex-start; background: #ffffff; color: #1f1d3a; border: 1px solid #e4e1f5; border-bottom-left-radius: 4px; }
    .ai-msg.user { align-self: flex-end; background: #4f46e5; color: #ffffff; border-bottom-right-radius: 4px; }

    /* "typing..." dots before each answer */
    .ai-typing span { display: inline-block; width: 7px; height: 7px; margin: 0 2px; border-radius: 50%; background: #8b5cf6; animation: aiDot 1s infinite; }
    .ai-typing span:nth-child(2) { animation-delay: 0.15s; }
    .ai-typing span:nth-child(3) { animation-delay: 0.3s; }
    @keyframes aiDot { 0%, 80%, 100% { opacity: 0.3; transform: translateY(0); } 40% { opacity: 1; transform: translateY(-4px); } }

    /* ready-made questions */
    .ai-chips { display: flex; gap: 6px; padding: 10px 12px; overflow-x: auto; border-top: 1px solid #e4e1f5; background: #ffffff; }
    .ai-chip { flex: none; padding: 6px 11px; border-radius: 999px; border: 1px solid #c4b5fd; background: #ffffff; color: #4c1d95; font: 600 0.78rem 'Manrope', 'Segoe UI', sans-serif; cursor: pointer; }
    .ai-chip:hover { background: #ede9fe; }

    .ai-input { display: flex; gap: 8px; padding: 12px; border-top: 1px solid #e4e1f5; background: #ffffff; }
    .ai-input input { flex: 1; min-width: 0; padding: 10px 12px; border: 1px solid #d4d0ea; border-radius: 10px; font: inherit; font-size: 1rem; }   /* 16px: phones do not zoom in */
    .ai-input input:focus { outline: none; border-color: #4f46e5; box-shadow: 0 0 0 3px rgba(79, 70, 229, 0.18); }
    .ai-send { padding: 0 16px; border: 0; border-radius: 10px; background: #4f46e5; color: #ffffff; font-weight: 700; cursor: pointer; }
    .ai-send:hover { background: #4338ca; }

    /* ===== 3. Phones and reduced motion ===== */
    @media (max-width: 480px) {
        .ai-launcher { padding: 6px; }
        .ai-label { display: none; }
        .ai-window { right: 16px; left: 16px; width: auto; max-width: none; }
    }
    @media (prefers-reduced-motion: reduce) {
        .ai-launcher .ai-avatar::after, .ai-typing span { animation: none; }
        .ai-teaser { display: none; }
    }
</style>

<div class="ai-teaser" id="aiTeaser" aria-hidden="true">Hi! I can help with your nomination. Ask me anything.</div>

<button type="button" class="ai-launcher" id="aiLauncher" onclick="toggleChat()" aria-label="Talk to AI" aria-controls="aiWindow" aria-expanded="false">
    <span class="ai-avatar">
        <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 3Q13 9.5 19.5 10.5Q13 11.5 12 18Q11 11.5 4.5 10.5Q11 9.5 12 3Z" fill="#ffffff"/><path d="M18.5 14.5Q19 17 21.5 17.5Q19 18 18.5 20.5Q18 18 15.5 17.5Q18 17 18.5 14.5Z" fill="#ffffff"/></svg>
        <span class="ai-dot"></span>
    </span>
    <span class="ai-label">Talk to AI</span>
</button>

<div class="ai-window" id="aiWindow" role="dialog" aria-label="AI assistant">
    <div class="ai-head">
        <span class="ai-avatar">
            <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 3Q13 9.5 19.5 10.5Q13 11.5 12 18Q11 11.5 4.5 10.5Q11 9.5 12 3Z" fill="#ffffff"/><path d="M18.5 14.5Q19 17 21.5 17.5Q19 18 18.5 20.5Q18 18 15.5 17.5Q18 17 18.5 14.5Z" fill="#ffffff"/></svg>
        </span>
        <div>
            <h3>AI Assistant</h3>
            <p>Online now</p>
        </div>
        <button type="button" class="ai-close" onclick="toggleChat()" aria-label="Close the chat">&times;</button>
    </div>
    <div class="ai-body" id="chatBody">
        <div class="ai-msg bot">Hi! I am your AI assistant. Ask me how to submit a nomination, log in with your NIC, upload evidence, check your status or book an interview.</div>
    </div>
    <div class="ai-chips">
        <button type="button" class="ai-chip" onclick="askFAQ('How do I submit a nomination?')">Submit a nomination</button>
        <button type="button" class="ai-chip" onclick="askFAQ('Which evidence files can I upload?')">Evidence files</button>
        <button type="button" class="ai-chip" onclick="askFAQ('How do I log in with my NIC?')">NIC login</button>
        <button type="button" class="ai-chip" onclick="askFAQ('What does my status mean?')">My status</button>
        <button type="button" class="ai-chip" onclick="askFAQ('How do I book an interview?')">Book an interview</button>
        <button type="button" class="ai-chip" onclick="askFAQ('How can I contact support?')">Support</button>
    </div>
    <div class="ai-input">
        <input type="text" id="chatInput" placeholder="Type your question" aria-label="Your question" onkeydown="handleKeyPress(event)">
        <button type="button" class="ai-send" onclick="sendUserMessage()">Send</button>
    </div>
</div>

<script>
    // ===== AI Assistant =====
    var chatOpen = false;

    // the greeting bubble shows only on the first page of a visit
    try {
        if (sessionStorage.getItem('aiTeaserSeen')) { document.getElementById('aiTeaser').style.display = 'none'; }
        sessionStorage.setItem('aiTeaserSeen', 'yes');
    } catch (e) { }

    // open / close the chat window
    function toggleChat() {
        chatOpen = !chatOpen;
        document.getElementById('aiWindow').classList.toggle('is-open', chatOpen);
        document.getElementById('aiLauncher').classList.toggle('is-open', chatOpen);
        document.getElementById('aiLauncher').setAttribute('aria-expanded', chatOpen ? 'true' : 'false');
        document.getElementById('aiTeaser').style.display = 'none';
        if (chatOpen) { document.getElementById('chatInput').focus(); }
        else { document.getElementById('aiLauncher').focus(); }
    }

    // the Esc key closes the chat
    document.addEventListener('keydown', function (e) {
        if (e.key === 'Escape' && chatOpen) { toggleChat(); }
    });

    // add one message bubble to the chat
    function appendMessage(sender, text) {
        var body = document.getElementById('chatBody');
        var msg = document.createElement('div');
        msg.className = 'ai-msg ' + sender;
        msg.textContent = text;
        body.appendChild(msg);
        body.scrollTop = body.scrollHeight;
        return msg;
    }

    // show the question, then "typing" dots, then the answer
    function reply(question) {
        appendMessage('user', question);
        var typing = appendMessage('bot', '');
        typing.classList.add('ai-typing');
        typing.innerHTML = '<span></span><span></span><span></span>';
        setTimeout(function () {
            typing.remove();
            appendMessage('bot', getBotResponse(question));
        }, 700);
    }

    function sendUserMessage() {
        var input = document.getElementById('chatInput');
        var text = input.value.trim();
        if (text === '') { return; }
        input.value = '';
        reply(text);
    }

    function askFAQ(question) { reply(question); }

    function handleKeyPress(e) { if (e.key === 'Enter') { sendUserMessage(); } }

    // keyword rules: the first matching topic gives the answer
    function getBotResponse(input) {
        var q = input.toLowerCase();
        if (q.includes('evidence') || q.includes('upload') || /\bfiles?\b/.test(q) || q.includes('pdf') || q.includes('certificate')) {
            return 'Upload one PDF, PNG or JPG file (up to 5 MB) in step 3 of the nomination form. You can drag the file onto the box or click the box to choose it.';
        } else if (q.includes('interview') || q.includes('slot') || q.includes('book')) {
            return 'Open My nomination and press "Book an interview". Choose an available slot and press "Book this slot". You can hold one slot at a time.';
        } else if (/\bnic\b/.test(q) || q.includes('login') || q.includes('log in') || q.includes('password')) {
            return 'Your NIC number is your login ID. On the nominee portal, type the NIC you used in the form (for example 981234567V or 200112345678) and press "Log in with NIC".';
        } else if (q.includes('status') || q.includes('review') || q.includes('approved') || q.includes('draft')) {
            return 'Draft: your nomination is saved. Under review: the committee is checking it. Approved: it is accepted. You can see your status at the top of My nomination.';
        } else if (q.includes('edit') || q.includes('update') || q.includes('change')) {
            return 'Open My nomination, change your details and press "Save changes". After saving, your status goes to Under review so the committee can check the changes.';
        } else if (q.includes('submit') || q.includes('nominate') || q.includes('nomination') || q.includes('add')) {
            return 'Press "Start a nomination" on the nominee portal. Fill in the name, NIC, organisation and biography, add an evidence file and press "Submit nomination".';
        } else if (q.includes('deadline') || q.includes('close') || q.includes('lock')) {
            return 'Each award category has a nomination deadline. After it passes you can no longer change your profile. See the Award calendar on the dashboard.';
        } else if (q.includes('delete') || q.includes('remove')) {
            return 'Only the award office can delete a nomination. Contact support@awardnomination.com if yours should be removed.';
        } else if (q.includes('support') || q.includes('contact') || q.includes('help')) {
            return 'Email support@awardnomination.com and the award office will help you.';
        } else if (q.includes('thank')) {
            return 'You are welcome. Good luck with your nomination!';
        } else if (/\b(hello|hi|hey)\b/.test(q)) {
            return 'Hello! Ask me about submitting a nomination, your NIC login, evidence files, your status or interviews.';
        }
        return 'I can help with nominations, NIC login, evidence files, status and interviews. Try one of the buttons above the message box, or email support@awardnomination.com.';
    }
</script>
